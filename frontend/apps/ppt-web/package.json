{
  "name": "@ppt/web",
  "private": true,
  "description": "Property Management Web Application (React SPA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build && echo 'Bundle analysis available at dist/stats.html'",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/**/*.a11y.test.tsx",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ppt/admin-ui": "workspace:*",
    "@ppt/api-client": "workspace:*",
    "@ppt/shared": "workspace:*",
    "@ppt/sitemap": "workspace:*",
    "@ppt/ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "dompurify": "^3.4.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.21.0",
    "react-hook-form": "^7.85.0",
    "@hookform/resolvers": "^5.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@ppt/dev-panel": "workspace:*",
    "@ppt/e2e": "workspace:*",
    "@ppt/vite-plugin-worktree": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "version": "0.3.218"
}

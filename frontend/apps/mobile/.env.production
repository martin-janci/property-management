# Production environment configuration
# Epic 85 - Story 85.1: Environment Variables
#
# SINGLE SOURCE OF TRUTH: variables in this file are loaded by app.config.ts
# (via dotenv) and injected into Constants.expoConfig.extra + ios.infoPlist.
# Read them in JS via src/config/api.ts → Constants.expoConfig.extra.
#
# EXPO_PUBLIC_* duplicates were removed (see issue #523) — app.config.ts is
# the authoritative path because EXPO_PUBLIC_* cannot reach iOS Info.plist.

# NOTE: CI is expected to overwrite API_BASE_URL / WS_BASE_URL with the real
# production host before building (e.g. via eas.json env). The sentinel below
# intentionally fails the build via the guard in app.config.ts if shipped.
API_BASE_URL=__SET_BY_CI__
WS_BASE_URL=__SET_BY_CI__
ENVIRONMENT=production
DEBUG_MODE=false
# gap-85-3: Universal Links / App Links host (iOS associatedDomains +
# Android https intentFilter). CI should override with the real production
# host before building; the well-known files must be served from this host.
APP_LINK_HOST=app.ppt.example.com

# Example environment configuration for ppt-mobile.
# Copy to .env.development, .env.staging, or .env.production and fill in values.
#
# Epic 85 - Story 85.1: Environment Variable Setup
#
# How it works:
#   1. app.config.ts (Expo dynamic config) loads this file via dotenv using
#      the APP_ENV environment variable (development|staging|production).
#      It injects values into:
#        - Constants.expoConfig.extra   (read in src/config/api.ts)
#        - ios.infoPlist                (native iOS keys: API_BASE_URL, ENVIRONMENT)
#
#   2. EXPO_PUBLIC_* variables are loaded automatically by Metro / the Expo
#      build system (SDK 49+) and are accessible as process.env.EXPO_PUBLIC_XXX.
#
#   3. src/config/api.ts checks Constants.expoConfig.extra first, then
#      falls back to process.env.EXPO_PUBLIC_*, then returns a safe default.
#
# Usage:
#   APP_ENV=staging pnpm --filter @ppt/mobile start   # run with staging config
#   APP_ENV=production pnpm --filter @ppt/mobile start:production

# --- Native / app.config.ts values ---
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
ENVIRONMENT=development
DEBUG_MODE=true

# --- Expo public env vars (Metro / Expo build system) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEBUG_MODE=true

# Example environment configuration for ppt-mobile.
# Copy to .env.development, .env.staging, or .env.production and fill in values.
#
# Epic 85 - Story 85.1: Environment Variable Setup
#
# How env vars flow:
#   1. app.config.ts loads this file via dotenv using APP_ENV env var.
#      Injects values into:
#        - Constants.expoConfig.extra   (read in src/config/api.ts)
#        - ios.infoPlist                (native iOS keys: API_BASE_URL, ENVIRONMENT)
#
#   2. EXPO_PUBLIC_* vars are loaded automatically by the Expo build system
#      (SDK 49+) and accessible as process.env.EXPO_PUBLIC_*.
#
#   3. src/config/api.ts checks Constants.expoConfig.extra first, then
#      falls back to process.env.EXPO_PUBLIC_*, then uses a safe default.
#
# Usage:
#   pnpm -F mobile start                        # uses .env.development
#   APP_ENV=staging pnpm -F mobile start        # uses .env.staging
#   APP_ENV=production pnpm -F mobile start     # uses .env.production

# --- app.config.ts / Info.plist values ---
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
ENVIRONMENT=development
DEBUG_MODE=true

# --- Expo public env vars (Metro / Expo build system) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEBUG_MODE=true

// Development.xcconfig
// Epic 85 - Story 85.2: Build Configuration by Environment (iOS)
//
// Per-environment iOS build settings for the Property Management app
// (three.two.bit.ppt.management). Selected at `expo prebuild` time by the
// `withIosBuildConfig` config plugin (plugins/withIosBuildConfig.ts) based on
// APP_ENV=development and copied into the generated `ios/` project as
// `PPTEnv.xcconfig`, then wired as the baseConfigurationReference of every
// build configuration.
//
// SINGLE SOURCE OF TRUTH NOTE
// ---------------------------
// Runtime config (the values JS reads at runtime via
// Constants.expoConfig.extra / ios.infoPlist) is still owned by
// `.env.development` -> app.config.ts. These xcconfig values mirror the same
// env so the *native build layer* (bundle id, display name, APP_ENV marker,
// API base URL) is configured consistently with that mechanism. Keep this file
// in sync with `.env.development` when the dev API host changes.

// Marker for the active environment (also surfaced as a user-defined build
// setting so it is greppable in the compiled product / build logs).
PPT_APP_ENV = development

// Bundle identifier — matches app.config.ts ios.bundleIdentifier and
// eas.json development profile. No suffix: EAS/Expo manage a single bundle id
// for this app; the environment is distinguished by APP_ENV + badged icon.
PRODUCT_BUNDLE_IDENTIFIER = three.two.bit.ppt.management

// Human-facing build marker (informational; the launcher name is set by Expo).
PPT_BUILD_DISPLAY_NAME = PPT Management (Dev)

// Backend API base URL for this environment — mirrors API_BASE_URL in
// .env.development. NOTE: `//` starts a comment in xcconfig, so the scheme
// separator in a URL must be written without inline trailing comments.
PPT_API_BASE_URL = http:/$()/localhost:8080

// App Transport Security posture marker: development allows cleartext HTTP to
// the local backend (mirrors app.config.ts NSAllowsArbitraryLoads for debug).
PPT_ALLOWS_ARBITRARY_LOADS = YES

{
  "name": "@ppt/mobile",
  "version": "0.3.218",
  "private": true,
  "description": "Property Management Mobile App (React Native)",
  "scripts": {
    "start": "expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:production": "APP_ENV=production expo start",
    "android": "expo start --android",
    "android:staging": "APP_ENV=staging expo start --android",
    "android:build": "expo run:android",
    "ios": "expo start --ios",
    "ios:staging": "APP_ENV=staging expo start --ios",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:android:staging": "eas build --platform android --profile staging",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios:staging": "eas build --platform ios --profile staging",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:mobile": "./scripts/build-mobile.sh",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@ppt/api-client": "workspace:*",
    "@ppt/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.2",
    "expo": "~57.0.16",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~56.0.19",
    "expo-image-picker": "~56.0.18",
    "expo-local-authentication": "~55.0.13",
    "expo-localization": "^57.0.1",
    "expo-location": "~57.0.13",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-native": "0.87.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-flow-strip-types": "^8.0.1",
    "@expo/config-plugins": "~57.0.9",
    "@expo/metro-config": "~57.0.10",
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.18",
    "dotenv": "^17.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.3.0"
  }
}

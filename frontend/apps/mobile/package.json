{
  "name": "@ppt/mobile",
  "private": true,
  "description": "Property Management Mobile App (React Native)",
  "scripts": {
    "start": "expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:production": "APP_ENV=production expo start",
    "android": "expo start --android",
    "android:staging": "APP_ENV=staging expo start --android",
    "android:build": "expo run:android",
    "ios": "expo start --ios",
    "ios:staging": "APP_ENV=staging expo start --ios",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:android:staging": "eas build --platform android --profile staging",
    "build:android:production": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios:staging": "eas build --platform ios --profile staging",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@ppt/api-client": "workspace:*",
    "@ppt/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "11.5.2",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~55.0.25",
    "expo-clipboard": "^56.0.4",
    "expo-constants": "~56.0.17",
    "expo-device": "~55.0.16",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~55.0.19",
    "expo-image-picker": "~56.0.16",
    "expo-local-authentication": "~55.0.13",
    "expo-localization": "^56.0.6",
    "expo-location": "~56.0.16",
    "expo-notifications": "~55.0.22",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25.7.3",
    "react": "^19.2.7",
    "react-i18next": "^16.5.1",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@expo/config-plugins": "~55.0.10",
    "@expo/metro-config": "~55.0.22",
    "@react-native/jest-preset": "^0.85.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.17",
    "dotenv": "^17.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "react-test-renderer": "^19.2.7",
    "typescript": "^5.3.0"
  },
  "version": "0.3.186"
}

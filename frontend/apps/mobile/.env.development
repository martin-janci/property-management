# Development environment configuration
# Epic 85 - Story 85.1: Environment Variables
#
# Variables without EXPO_PUBLIC_ prefix are loaded by app.config.ts (dotenv)
# and injected into Constants.expoConfig.extra and iOS Info.plist.
#
# Variables with EXPO_PUBLIC_ prefix are loaded natively by the Expo build
# system (SDK 49+) and are accessible as process.env.EXPO_PUBLIC_* in JS.
#
# Both sets are kept in sync — update both when adding a new variable.

# --- Native / app.config.ts values ---
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080
ENVIRONMENT=development
DEBUG_MODE=true

# --- Expo public env vars (Metro / Expo build system) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEBUG_MODE=true

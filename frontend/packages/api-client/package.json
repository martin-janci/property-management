    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.100.14",
    "@tanstack/react-query": "^5.100.14"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "version": "0.3.84"
}

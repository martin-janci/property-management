{
  "name": "@ppt/api-client",
  "private": true,
  "description": "API client for Property Management (api-server)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-ts -i ../../../docs/api/generated/openapi.yaml -o ./src/generated",

{
  "name": "@ppt/screen-map",
  "private": true,
  "version": "0.3.218",
  "description": "Project-management screen-map: types, parse/write, validate, CLI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "screen-map": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@ppt/sitemap": "workspace:*",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.32",
    "yauzl-promise": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}

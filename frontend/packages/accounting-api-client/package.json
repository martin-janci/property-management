{
  "name": "@ppt/accounting-api-client",
  "private": true,
  "description": "API client for the Accounting Portal (accounting-server :8082)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-ts -i ../../../docs/api/generated/accounting-openapi.json -o ./src/generated",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^25.9.3",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "version": "0.1.0"
}

{
  "name": "ppt-frontend",
  "private": true,
  "description": "PPT Frontend Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:ppt": "pnpm --filter @ppt/web dev",
    "dev:reality": "pnpm --filter @ppt/reality-web dev",
    "dev:accounting": "pnpm --filter @ppt/accounting-web dev",
    "dev:mobile": "pnpm --filter @ppt/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "generate-api": "pnpm --filter @ppt/api-client generate",
    "generate-reality-api": "pnpm --filter @ppt/reality-api-client generate",
    "generate-accounting-api": "pnpm --filter @ppt/accounting-api-client generate",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm -r --filter './apps/*' e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-test-renderer": "19.2.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@react-native/babel-plugin-codegen": "^0.85.0"
    }
  },
  "packageManager": "pnpm@8.14.0"
}

# backend/servers/deploy-server/systemd/ppt-deploy.service
[Unit]
Description=ppt-deploy on-demand server
Requires=ppt-deploy.socket
After=network.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ppt-deploy
User=ppt-deploy
Group=ppt-deploy
Environment=PPT_DEPLOY_ETC=/etc/ppt-deploy
Environment=RUST_LOG=info
# LISTEN_FDS / LISTEN_PID are set automatically by systemd when this service is
# started via socket activation (Requires=ppt-deploy.socket). Hardcoding them
# here would lie to the binary on direct `systemctl start ppt-deploy.service`
# invocations and confuse the listenfd crate's check.
EnvironmentFile=-/etc/ppt-deploy/secrets.env
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30s
Restart=on-failure

[Install]
WantedBy=multi-user.target

# Template — `${BG_TARGET}` and `${BG_COLOR}` are filled in at container
# startup by /docker-entrypoint.d/10-render-template.sh via `envsubst` so the
# `proxy_pass` upstream resolves to the same blue/green color of api-server
# in the same Docker network as this ppt-web container.
#
# Shared, churn-prone boilerplate (relative redirects, gzip, common security
# headers) lives in /etc/nginx/partials/*.conf and is pulled in via `include`
# below. Only the bits that genuinely differ from admin-web stay inline here.

# --- Layout-preview frame-ancestors carve-out (env-gated) -------------------
# Mirrors reality-web's LAYOUT_PREVIEW_FRAME_ANCESTORS semantics: when the env
# var is set (space-separated origins) AND the request carries layoutPreview=1
# in the query string, serve `Content-Security-Policy: frame-ancestors
# <origins>` and omit X-Frame-Options (it cannot express allowlists; CSP
# frame-ancestors supersedes it in all modern browsers). Otherwise the
# SAMEORIGIN / frame-ancestors 'self' policy below applies unchanged.
#
# `${LAYOUT_PREVIEW_FRAME_ANCESTORS}` is envsubst'd at container startup with
# a safe empty default — unset env means the carve-out can never activate.

# Query gate: origins only flow through on ?layoutPreview=1
map $arg_layoutPreview $ppt_layout_preview_ancestors {
    default "";
    "1"     "${LAYOUT_PREVIEW_FRAME_ANCESTORS}";
}

# X-Frame-Options value: empty string ⇒ nginx omits the header entirely
map $ppt_layout_preview_ancestors $ppt_xfo_value {
    default "SAMEORIGIN";
    "~."    "";
}

# frame-ancestors source list for the CSP header
map $ppt_layout_preview_ancestors $ppt_frame_ancestors {
    default "'self'";
    "~."    $ppt_layout_preview_ancestors;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Relative redirects + gzip (shared with admin-web).
    include /etc/nginx/partials/server-common.conf;

    # Security headers
    include /etc/nginx/partials/security-headers-common.conf;
    # $ppt_xfo_value is "SAMEORIGIN" normally; empty (header omitted) only for
    # the env-gated layoutPreview carve-out — see the map blocks above.
    add_header X-Frame-Options $ppt_xfo_value always;
    # CSP — was missing (#954). frame-ancestors mirrors the X-Frame-Options
    # policy above ('self' normally, the allowlisted origins in the preview
    # carve-out); connect-src is kept permissive (https:/wss:) so same-origin
    # /api + /ws proxying and any external uploads/telemetry keep working.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors $ppt_frame_ancestors; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # Cache static assets. `add_header` in a location does NOT inherit the
    # parent's headers, so re-include the common set + re-declare X-Frame-Options.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/partials/security-headers-common.conf;
        add_header X-Frame-Options $ppt_xfo_value always;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Cross-origin shim for the SPA: ppt-web is built with
    # `VITE_API_URL=` (empty) so the bundle issues `fetch('/api/v1/...')`
    # against its own origin (ppt.<ppt_apex>). The api-server lives at
    # api.<ppt_apex> — different host, the relative fetches would never
    # reach it. Proxy `/api/` (REST) and `/ws/` (WebSocket) here so the
    # browser's same-origin fetches reach the api-server container in the
    # same target's Docker network.
    #
    # Upstream is `${BG_TARGET}-api-${BG_COLOR}:8080`. The deploy-server's
    # blue/green flow always brings up ppt-{target}-{color} together with
    # api-{target}-{color}, so this ppt-web's color matches the api-server
    # color in the same network — no need to track the active color.
    #
    # If `${BG_TARGET}` or `${BG_COLOR}` is empty (e.g. running the image
    # outside the deploy-server's blue/green flow), nginx will fail to
    # resolve the upstream and return 502 — preferable to silently routing
    # /api to the SPA fallback.
    location /api/ {
        proxy_pass http://${BG_TARGET}-api-${BG_COLOR}:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Generous timeout for slow integration handlers (Adobe Sign,
        # large building/unit imports etc.). The api-server serves
        # /health quickly so the deploy-server's health-grace probe is
        # unaffected.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location /ws/ {
        proxy_pass http://${BG_TARGET}-api-${BG_COLOR}:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSockets need long read timeout — the connection stays open
        # for the lifetime of the user session.
        proxy_read_timeout 86400s;
    }

    # SPA routing - serve index.html for all routes (must come AFTER /api
    # and /ws so they don't fall through to the static fallback).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}

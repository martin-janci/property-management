frontend/node_modules/
frontend/**/node_modules/
frontend/**/dist/
frontend/**/build/
frontend/**/.next/
frontend/**/coverage/
frontend/pnpm-lock.yaml
# Worktree-root pnpm artifacts (created by stray `pnpm install` at repo root)
/node_modules/
/pnpm-lock.yaml

# === Mobile Native (Kotlin) ===
!mobile-native/
!mobile-native/**
mobile-native/.gradle/
mobile-native/build/
mobile-native/**/build/
mobile-native/local.properties
mobile-native/.kotlin/

# === API Specs ===
# Keep generated specs (they're the source of truth)
# But ignore node_modules and tsp-output from typespec
docs/api/typespec/node_modules/
docs/api/typespec/tsp-output/

# === GitHub Actions ===
!.github/
!.github/**

# === Environment ===
.env
.env.local
.env.*.local
*.env

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Testing ===
coverage/
*.lcov

